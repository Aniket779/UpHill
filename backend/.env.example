PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/uphill

# AI coach (POST /ai/feedback) — Google Gemini
GEMINI_API_KEY=

# Auth — required, no fallback. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_long_random_secret

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:5173
